+void CRemoteDesktopPortal::releaseHeldInput(SSession* session) {
+    if (!session)
+        return;
+
+    const uint32_t t = currentTimeMs();
+    if (session->virtualPointer) {
+        for (const int32_t button : session->pressedButtons)
+            session->virtualPointer->sendButton(t, button, 0);
+        if (!session->pressedButtons.empty())
+            session->virtualPointer->sendFrame();
+    }
+    if (session->virtualKeyboard) {
+        for (const int32_t key : session->pressedKeycodes) {
+            session->virtualKeyboard->sendKey(t, key, 0);
+            if (session->xkbState)
+                xkb_state_update_key(session->xkbState, key + 8, XKB_KEY_UP);
+        }
+        if (session->xkbState)
+            sendModifiers(session->virtualKeyboard.get(), session->xkbState, 0);
+    }
+    session->pressedButtons.clear();
+    session->pressedKeycodes.clear();
+    session->keysymModifiers.clear();
+    session->keysymKeycodes.clear();
+    if (g_pPortalManager->m_sWaylandConnection.display)
+        wl_display_flush(g_pPortalManager->m_sWaylandConnection.display);
+}
+
+void CRemoteDesktopPortal::closeAllSessions(const char* reason) {
+    Debug::log(LOG, "[remotedesktop] closing all sessions ({})", reason ? reason : "unspecified");
+
+    // Practical safeguard: let the user run a hook (e.g. restart the remote
+    // desktop client so the viewer sees a real disconnect). Opt-in: only runs
+    // if ~/.local/bin/xdph-rd-on-lock exists and is executable.
+    if (const char* home = getenv("HOME"); home && reason && std::string{reason} == "screen locked") {
+        const std::string hook = std::string{home} + "/.local/bin/xdph-rd-on-lock";
+        if (access(hook.c_str(), X_OK) == 0) {
+            Debug::log(LOG, "[remotedesktop] running lock hook {}", hook);
+            pid_t pid = fork();
+            if (pid == 0) {
+                setsid();
+                if (fork() == 0) {
+                    execl(hook.c_str(), hook.c_str(), (char*)nullptr);
+                    _exit(127);
+                }
+                _exit(0);
+            } else if (pid > 0)
+                waitpid(pid, nullptr, 0);
+        }
+    }
+
+    std::vector<sdbus::ObjectPath> paths;
+    paths.reserve(m_vSessions.size());
+    for (const auto& s : m_vSessions)
+        paths.push_back(s->sessionHandle);
+
+    for (const auto& path : paths) {
+        SSession* s = getSession(path);
+        if (!s)
+            continue;
+
+        releaseHeldInput(s);
+        s->virtualPointer.reset();
+        s->virtualKeyboard.reset();
+
+        if (s->session && s->session->object) {
+            try {
+                s->session->object->emitSignal(sdbus::SignalName{"Closed"}).onInterface(sdbus::InterfaceName{"org.freedesktop.impl.portal.Session"});
+            } catch (const std::exception& e) { Debug::log(WARN, "[remotedesktop] failed to emit Session.Closed: {}", e.what()); }
+        }
+
+        if (s->session) {
+            auto destroy = std::move(s->session->onDestroy);
+            s->session->object.reset();
+            if (destroy)
+                destroy();
+            else
+                destroySession(path);
+        } else
+            destroySession(path);
+    }
+}
+
+void CRemoteDesktopPortal::setupLockWatch() {
+    const char* signature = getenv("HYPRLAND_INSTANCE_SIGNATURE");
+    const char* runtime   = getenv("XDG_RUNTIME_DIR");
+    if (!signature || !*signature || !runtime || !*runtime) {
+        Debug::log(WARN, "[remotedesktop] Hyprland IPC unavailable; lock watch disabled");
+        return;
+    }
+
+    const std::string path = std::format("{}/hypr/{}/.socket2.sock", runtime, signature);
+    const int         fd   = socket(AF_UNIX, SOCK_STREAM | SOCK_CLOEXEC | SOCK_NONBLOCK, 0);
+    if (fd < 0) {
+        Debug::log(WARN, "[remotedesktop] lock watch socket() failed: {}", strerror(errno));
+        return;
+    }
+
+    sockaddr_un addr{};
+    addr.sun_family = AF_UNIX;
+    if (path.size() >= sizeof(addr.sun_path)) {
+        Debug::log(WARN, "[remotedesktop] Hyprland IPC path too long");
+        close(fd);
+        return;
+    }
+    std::memcpy(addr.sun_path, path.c_str(), path.size() + 1);
+
+    if (connect(fd, reinterpret_cast<sockaddr*>(&addr), sizeof(addr)) < 0) {
+        Debug::log(WARN, "[remotedesktop] cannot connect to {}: {}", path, strerror(errno));
+        close(fd);
+        return;
+    }
+
+    m_hyprlandIpcFd = fd;
+    g_pPortalManager->addFdToEventLoop(fd, POLLIN, [this] { onHyprlandIpcEvent(); });
+    Debug::log(LOG, "[remotedesktop] watching Hyprland IPC for lock events at {}", path);
+}
+
+void CRemoteDesktopPortal::onHyprlandIpcEvent() {
+    if (m_hyprlandIpcFd < 0)
+        return;
+
+    char buf[4096];
+    while (true) {
+        const ssize_t n = read(m_hyprlandIpcFd, buf, sizeof(buf));
+        if (n < 0) {
+            if (errno == EINTR)
+                continue;
+            if (errno == EAGAIN || errno == EWOULDBLOCK)
+                break;
+            Debug::log(WARN, "[remotedesktop] Hyprland IPC read failed: {}", strerror(errno));
+            g_pPortalManager->removeFdFromEventLoop(m_hyprlandIpcFd);
+            close(m_hyprlandIpcFd);
+            m_hyprlandIpcFd = -1;
+            break;
+        }
+        if (n == 0) {
+            Debug::log(WARN, "[remotedesktop] Hyprland IPC closed");
+            g_pPortalManager->removeFdFromEventLoop(m_hyprlandIpcFd);
+            close(m_hyprlandIpcFd);
+            m_hyprlandIpcFd = -1;
+            break;
+        }
+        m_hyprlandIpcBuf.append(buf, static_cast<size_t>(n));
+    }
+
+    size_t pos = 0;
+    while (true) {
+        const size_t nl = m_hyprlandIpcBuf.find('\n', pos);
+        if (nl == std::string::npos) {
+            m_hyprlandIpcBuf.erase(0, pos);
+            break;
+        }
+        const std::string_view line(m_hyprlandIpcBuf.data() + pos, nl - pos);
+        pos = nl + 1;
+        // Hyprland emits "lock>>" when the session lock activates.
+        if (line.starts_with("lock>>"))
+            closeAllSessions("screen locked");
+    }
+}
+
 void CRemoteDesktopPortal::destroySession(const sdbus::ObjectPath& path) {
+    if (const auto PSESSION = getSession(path))
+        releaseHeldInput(PSESSION);
+
     if (g_pPortalManager->m_sPortals.screencopy)
         g_pPortalManager->m_sPortals.screencopy->destroyRemoteDesktopSession(path);
 
