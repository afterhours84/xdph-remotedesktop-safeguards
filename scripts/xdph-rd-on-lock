#!/bin/sh
# Optional lock hook for the patched xdph RemoteDesktop backend.
# Called after remote sessions are closed on screen lock, if installed as
# ~/.local/bin/xdph-rd-on-lock and marked executable.
#
# Restarts RustDesk so the remote viewer gets a real disconnect and the next
# connection starts a fresh portal session. Works around RustDesk 1.5.0 keeping
# a stale portal session after the viewer leaves or the portal closes it.
# See known limitations in README.md.
#
# Adjust LOG and the rustdesk binary path as needed.

LOG="${XDG_STATE_HOME:-$HOME/.local/state}/xdph-rd/lock-hook.log"
mkdir -p "$(dirname "$LOG")"
echo "$(date -Is) lock hook: restarting rustdesk" >> "$LOG"
pkill -x rustdesk
sleep 2
setsid -f /usr/bin/rustdesk >/dev/null 2>&1
echo "$(date -Is) rustdesk relaunched: $(pgrep -x rustdesk | tr '\n' ' ')" >> "$LOG"
